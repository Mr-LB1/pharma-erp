# 构建工具与依赖（本地 .tools，不入库）
../.tools/

# 后端
backend/target/
backend/BOOT-INF/
*.class
*.jar
*.log
!.mvn/wrapper/maven-wrapper.jar
.idea/
*.iml
.vscode/

# 前端
frontend/node_modules/
frontend/dist/
*.tsbuildinfo
*.local
.DS_Store
Thumbs.db

# 本地敏感配置（数据库口令 / JWT 密钥），模板见 backend/config/local-dev.yml.example
backend/config/local-dev.yml
.env.local

# 运行时数据与进程文件（Redis 落盘、pid、日志目录）
*.aof
*.rdb
*.pid
logs/

# 数据库备份（pg_dump 产物，含业务数据，不入库）
backups/

# 子对话临时交接文档（只保留目录占位）
docs/handoffs/*.md
!docs/handoffs/.gitkeep
