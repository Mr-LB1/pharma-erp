# 本地开发配置模板
#
# 复制为同目录下的 local-dev.yml（该文件已被 .gitignore 忽略，切勿提交）：
#   cp backend/config/local-dev.yml.example backend/config/local-dev.yml
#
# 也可改用环境变量注入（优先级高于本文件）：DB_PASSWORD / JWT_SECRET / DB_URL / DB_USER
spring:
  datasource:
    password: 你的本地数据库口令

# 生产必须注入独立密钥；本地可留空使用 application.yml 中的开发默认值
# app:
#   jwt:
#     secret: 至少 32 字节的随机字符串
